{
  "name": "mp3-player",
  "version": "2.4.0",
  "description": "墨韵 MoYun — Vue 3 多音源在线音乐播放器",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "pnpm run lint && vue-tsc --noEmit && pnpm run test"
  },
  "license": "MIT",
  "dependencies": {
    "howler": "^2.2.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
